{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": { "@/*": ["./src/*"], "@shared/*": ["../shared/*"] }
  },
  "include": ["src", "../shared", "vite.config.ts"]
}
