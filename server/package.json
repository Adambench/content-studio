    "@hyperframes/core": "0.8.158",
    "@hyperframes/producer": "0.8.158",
    "@puppeteer/browsers": "^3.2.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "gsap": "^3.15.0",
    "puppeteer-core": "^25.14.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
